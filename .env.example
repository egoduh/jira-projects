# Скопируй этот файл в .env и подставь свои значения.
# .env в git не попадает (см. .gitignore).

JIRA_BASE_URL=https://jira.company.ru

# --- Авторизация: ЛИБО токен, ЛИБО cookie (что-то одно) ---

# Вариант A: токен Kantega
JIRA_TOKEN=вставь-токен-из-Kantega

# Вариант B: готовая SSO-сессия из браузера (если токен не принимается).
# Открой Jira в браузере (ты залогинен), DevTools -> Application -> Cookies ->
# скопируй значение JSESSIONID. Токен при этом НЕ нужен.
# JIRA_COOKIE=JSESSIONID=вставь-сюда

# Режим авторизации токеном Kantega SSO Enterprise:
#   ksso   — нативная схема Kantega: Authorization: ksso-token <токен>  (пробуй ПЕРВЫМ)
#   basic  — логин + токен как пароль: -u <логин>:<токен>
#   bearer — Authorization: Bearer <токен> (обычный PAT; для Kantega обычно НЕ подходит)
# JIRA_AUTH_MODE=ksso
#
# Для basic нужен логин:
# JIRA_USERNAME=твой-логин
#
# Если админ настроил СВОЁ имя схемы — задай его (шлётся "Authorization: <схема> <токен>"):
# JIRA_AUTH_SCHEME=ksso-token

# --- TLS: корпоративный сертификат Jira ---
# Правильный путь: указать файл корпоративного CA (PEM/CRT) — доверие + проверка сохраняются:
# JIRA_CACERT=C:\certs\company-ca.crt
#
# Быстрый путь (последнее средство): вообще не проверять сертификат:
# JIRA_INSECURE=1

# Порт локального сайта (по умолчанию 8000):
# PORT=8000
